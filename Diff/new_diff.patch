+```ts
+import { Router, type Request, type Response } from "express";
+import type { Logger } from "pino";
+import type { AmcpClient } from "./amcpClient.js";
+
+interface CommandLogger {
+  info: (...args: any[]) => void;
+  warn: (...args: any[]) => void;
+  error: (...args: any[]) => void;
+}
+
+const noopLogger: CommandLogger = {
+  info: () => {},
+  warn: () => {},
+  error: () => {},
+};
+
+const DEFAULT_CHANNEL = 1;
+const DEFAULT_LAYER = 1;
+
+function toPositiveInt(value: unknown, fallback: number): number {
+  const num = typeof value === "number" ? value : Number.parseInt(String(value ?? ""), 10);
+  return Number.isFinite(num) && num > 0 ? Math.floor(num) : fallback;
+}
+
+function sanitizeClip(raw: unknown): string | null {
+  if (typeof raw !== "string") return null;
+  const clip = raw.trim();
+  return clip.length > 0 ? clip : null;
+}
+
+function escapeClip(clip: string): string {
+  return clip.replace(/"/g, '\\"');
+}
+
+function formatTarget(channel: number, layer: number): string {
+  return `${channel}-${layer}`;
+}
+
+function parseAddress(input: { channel?: unknown; layer?: unknown } | undefined) {
+  return {
+    channel: toPositiveInt(input?.channel, DEFAULT_CHANNEL),
+    layer: toPositiveInt(input?.layer, DEFAULT_LAYER),
+  };
+}
+
+async function dispatch(
+  res: Response,
+  action: string,
+  exec: () => Promise<string>,
+  logger: CommandLogger,
+  context: Record<string, unknown>,
+) {
+  try {
+    const resp = await exec();
+    logger.info({ action, ...context, resp }, "AMCP command dispatched");
+    res.status(200).json({ ok: true, resp });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    logger.error({ action, ...context, err: error }, "AMCP command failed");
+    res.status(502).json({ ok: false, error: message });
+  }
+}
+
+export function createCasparRouter(
+  amcp: Pick<AmcpClient, "send">,
+  logger?: Pick<Logger, "info" | "warn" | "error">,
+) {
+  const log: CommandLogger = logger ?? noopLogger;
+  const router = Router();
+
+  router.post("/play", async (req: Request, res: Response) => {
+    const clip = sanitizeClip(req.body?.clip);
+    if (!clip) {
+      res.status(400).json({ ok: false, error: "clip is required" });
+      return;
+    }
+    const { channel, layer } = parseAddress(req.body);
+    const target = formatTarget(channel, layer);
+    await dispatch(
+      res,
+      "play",
+      () => amcp.send(`PLAY ${target} "${escapeClip(clip)}"`),
+      log,
+      { clip, channel, layer },
+    );
+  });
+
+  router.post("/stop", async (req: Request, res: Response) => {
+    const { channel, layer } = parseAddress(req.body);
+    const target = formatTarget(channel, layer);
+    await dispatch(res, "stop", () => amcp.send(`STOP ${target}`), log, { channel, layer });
+  });
+
+  router.post("/loadbg", async (req: Request, res: Response) => {
+    const clip = sanitizeClip(req.body?.clip);
+    if (!clip) {
+      res.status(400).json({ ok: false, error: "clip is required" });
+      return;
+    }
+    const { channel, layer } = parseAddress(req.body);
+    const loop = Boolean(req.body?.loop);
+    const target = formatTarget(channel, layer);
+    const loopSuffix = loop ? " LOOP" : "";
+    await dispatch(
+      res,
+      "loadbg",
+      () => amcp.send(`LOADBG ${target} "${escapeClip(clip)}"${loopSuffix}`),
+      log,
+      { clip, channel, layer, loop },
+    );
+  });
+
+  return router;
+}
+
+export type { CommandLogger };
+```
