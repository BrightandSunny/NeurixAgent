+import assert from "node:assert/strict";
+import { applyOscUpdate, type StatusEvent } from "../../src/oscBridge.js";
+
+// AT-OSC-STATUS-001: OSC updates must retain clip/time/fps/duration state per channel/layer.
+async function main() {
+  const state = new Map<string, StatusEvent>();
+
+  let payload = applyOscUpdate(state, {
+    address: "/channel/1/stage/layer/1/file/name",
+    args: ["AMB"],
+  });
+  assert.ok(payload, "clip name update should emit payload");
+  assert.equal(payload?.clipName, "AMB");
+  assert.equal(payload?.onAir, true);
+
+  payload = applyOscUpdate(state, {
+    address: "/channel/1/stage/layer/1/file/time",
+    args: ["00:00:05", 25],
+  });
+  assert.ok(payload, "time update should emit payload");
+  assert.equal(payload?.clipName, "AMB", "clipName should persist across updates");
+  assert.equal(payload?.timecode, "00:00:05");
+  assert.equal(payload?.fps, 25);
+  assert.equal(payload?.onAir, true);
+
+  payload = applyOscUpdate(state, {
+    address: "/channel/1/stage/layer/1/file/time",
+    args: [
+      { type: "s", value: "00:00:06" },
+      { type: "f", value: 29.97 },
+    ],
+  });
+  assert.ok(payload, "structured OSC args should be unwrapped");
+  assert.equal(payload?.timecode, "00:00:06");
+  assert.equal(payload?.fps, 29.97);
+
+  payload = applyOscUpdate(state, {
+    address: "/channel/1/stage/layer/1/file/duration",
+    args: ["00:00:10"],
+  });
+  assert.ok(payload);
+  assert.equal(payload?.duration, "00:00:10");
+  assert.equal(payload?.clipName, "AMB");
+
+  payload = applyOscUpdate(state, {
+    address: "/channel/1/stage/layer/1/file/frame",
+    args: [42],
+  });
+  assert.ok(payload);
+  assert.equal(payload?.frame, 42);
+
+  payload = applyOscUpdate(state, {
+    address: "/channel/1/stage/layer/1/foreground",
+    args: [0],
+  });
+  assert.ok(payload);
+  assert.equal(payload?.onAir, false);
+  assert.equal(payload?.clipName, "AMB");
+
+  const noChange = applyOscUpdate(state, {
+    address: "/channel/1/stage/layer/1/file/frame",
+    args: [42],
+  });
+  assert.equal(noChange, null, "repeated values should not emit");
+}
