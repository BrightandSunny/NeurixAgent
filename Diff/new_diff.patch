+import { OscBridge } from "../oscBridge.js";
+import { cfg } from "../config/env.js";
+import { publishStatus } from "../ws/statusServer.js";
+import { log } from "../logger.js";
+
+let bridge: OscBridge | null = null;
+
+export function startOscIngest() {
+  if (!bridge) {
+    bridge = new OscBridge(cfg.osc.listenPort);
+    bridge.on("status", (event) => publishStatus(event));
+    bridge.start();
+    log.info({ port: cfg.osc.listenPort }, "OSC ingest started");
+  }
+  return bridge;
+}
+
+export function stopOscIngest() {
+  if (bridge) {
+    bridge.removeAllListeners("status");
+    bridge.stop();
+    log.info({ port: cfg.osc.listenPort }, "OSC ingest stopped");
+    bridge = null;
+  }
+}
+```
