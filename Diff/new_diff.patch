+## `server/src/amcpClient.ts`
+```ts
+import net from "node:net";
+
+/**
+ * AMCP client with a single persistent TCP socket and a tiny command queue.
+ * Resolves on the first CRLF-terminated reply line (e.g. "202 PLAY OK").
+ */
+export class AmcpClient {
+  private socket: net.Socket | null = null;
+  private connecting = false;
+  private queue: Array<{ cmd: string; resolve: (s: string) => void; reject: (e: any) => void }> = [];
+  private busy = false;
+  private disposed = false;
+
+  constructor(private host: string, private port: number, private timeoutMs = 2000) {}
+
+  private async getSocket(): Promise<net.Socket> {
+    if (this.disposed) {
+      throw new Error("AMCP client disposed");
+    }
+    if (this.socket && !this.socket.destroyed) return this.socket;
+    if (this.connecting) {
+      await new Promise((r) => setTimeout(r, 25));
+      return this.getSocket();
+    }
+    this.connecting = true;
+    this.socket = net.createConnection({ host: this.host, port: this.port });
+    await new Promise<void>((res, rej) => {
+      const onErr = (e: Error) => rej(e);
+      this.socket!.once("error", onErr);
+      this.socket!.once("connect", () => {
+        this.socket!.off("error", onErr);
+        res();
+      });
+    });
+    this.connecting = false;
+    return this.socket!;
+  }
+
+  /** Enqueue and return the reply line */
+  async send(command: string): Promise<string> {
+    if (this.disposed) {
+      return Promise.reject(new Error("AMCP client disposed"));
+    }
+    return new Promise<string>(async (resolve, reject) => {
+      this.queue.push({ cmd: command, resolve, reject });
+      if (!this.busy) {
+        this.busy = true;
+        try {
+          while (this.queue.length) {
+            const item = this.queue.shift()!;
+            try {
+              const line = await this.dispatch(item.cmd);
+              item.resolve(line);
+            } catch (e) {
+              item.reject(e);
+            }
+          }
+        } finally {
+          this.busy = false;
+        }
+      }
+    });
+  }
+
+  private async dispatch(command: string): Promise<string> {
+    const sock = await this.getSocket();
+    const payload = `${command}\r\n`;
+    let buffer = "";
+    return new Promise<string>((res, rej) => {
+      const timeout = setTimeout(() => {
+        cleanup();
+        rej(new Error("AMCP timeout"));
+      }, this.timeoutMs);
+
+      const onData = (b: Buffer) => {
+        buffer += b.toString("utf8");
+        const i = buffer.indexOf("\r\n");
+        if (i !== -1) {
+          const line = buffer.slice(0, i); // first reply line is enough for OK/ERR
+          cleanup();
+          res(line);
+        }
+      };
+      const onErr = (e: Error) => {
+        cleanup();
+        rej(e);
+      };
+      const cleanup = () => {
+        clearTimeout(timeout);
+        sock.off("data", onData);
+        sock.off("error", onErr);
+      };
+      sock.on("data", onData);
+      sock.once("error", onErr);
+      sock.write(payload);
+    });
+  }
+
+  dispose() {
+    this.disposed = true;
+    if (this.socket && !this.socket.destroyed) {
+      this.socket.destroy();
+    }
+    this.socket = null;
+    this.connecting = false;
+    while (this.queue.length) {
+      const item = this.queue.shift();
+      if (item) item.reject(new Error("AMCP client disposed"));
+    }
+    this.busy = false;
+  }
+}
+```
