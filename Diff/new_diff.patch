+import assert from "node:assert/strict";
+import fs from "node:fs";
+import http from "node:http";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import express from "express";
+import { createCasparRouter } from "../../src/restApi.js";
+
+const FORBIDDEN_DEPENDENCIES = [
+  "wrtc",
+  "mediasoup",
+  "simple-peer",
+  "jitsi-meet",
+  "livekit-server",
+];
+
+async function ensureForbiddenDepsAbsent(repoRoot: string) {
+  const packageJsonPath = path.join(repoRoot, "server", "package.json");
+  const pkg = JSON.parse(await fs.promises.readFile(packageJsonPath, "utf8"));
+  const sections = [pkg.dependencies ?? {}, pkg.devDependencies ?? {}];
+  for (const forbidden of FORBIDDEN_DEPENDENCIES) {
+    for (const section of sections) {
+      assert.ok(
+        !Object.prototype.hasOwnProperty.call(section, forbidden),
+        `Forbidden dependency detected: ${forbidden}`,
+      );
+    }
+  }
+}
+
+async function ensureHlsArtifact(repoRoot: string) {
+  const preview = path.join(repoRoot, "previewer", "public", "preview", "main.m3u8");
+  const stat = await fs.promises.stat(preview);
+  assert.ok(stat.isFile(), "HLS preview manifest must exist");
+}
+
+async function ensureCasparRoutes() {
+  const issued: string[] = [];
+  const app = express();
+  app.use(express.json());
+  app.use(
+    "/api/caspar",
+    createCasparRouter(
+      {
+        send: async (command: string) => {
+          issued.push(command);
+          return "202 OK";
+        },
+      },
+    ),
+  );
+
+  const server = http.createServer(app);
+  await new Promise<void>((resolve) => server.listen(0, resolve));
+  const address = server.address();
+  assert.ok(address && typeof address === "object", "Server must expose address info");
+  const port = address.port;
+
+  const baseUrl = `http://127.0.0.1:${port}`;
+
+  // AT-CASPAR-REST-001: PLAY command dispatch
+  let response = await fetch(`${baseUrl}/api/caspar/play`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ clip: "AMB" }),
+  });
+  assert.equal(response.status, 200, "play should return HTTP 200");
+  let body = await response.json();
+  assert.equal(body.ok, true, "play payload should confirm success");
+  assert.equal(issued.at(-1), 'PLAY 1-1 "AMB"');
+
+  // AT-CASPAR-REST-002: STOP command dispatch with override
+  response = await fetch(`${baseUrl}/api/caspar/stop`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ channel: 2, layer: 3 }),
+  });
+  assert.equal(response.status, 200, "stop should return HTTP 200");
+  body = await response.json();
+  assert.equal(body.ok, true, "stop payload should confirm success");
+  assert.equal(issued.at(-1), "STOP 2-3");
+
+  // AT-CASPAR-REST-003: LOADBG command dispatch with loop
+  response = await fetch(`${baseUrl}/api/caspar/loadbg`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ clip: "LOOP", loop: true }),
+  });
+  assert.equal(response.status, 200, "loadbg should return HTTP 200");
+  body = await response.json();
+  assert.equal(body.ok, true, "loadbg payload should confirm success");
+  assert.equal(issued.at(-1), 'LOADBG 1-1 "LOOP" LOOP');
+
+  // AT-CASPAR-REST-004: clip validation
+  response = await fetch(`${baseUrl}/api/caspar/loadbg`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ clip: "   " }),
+  });
+  assert.equal(response.status, 400, "clip validation should trigger HTTP 400");
+
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+}
+
+async function main() {
+  const __filenameLocal = fileURLToPath(import.meta.url);
+  const __dirnameLocal = path.dirname(__filenameLocal);
+  const serverRoot = path.resolve(__dirnameLocal, "..", "..");
+  const repoRoot = path.resolve(serverRoot, "..");
+
+  await ensureForbiddenDepsAbsent(repoRoot);
+  await ensureHlsArtifact(repoRoot);
+  await ensureCasparRoutes();
+}
+
+main().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
