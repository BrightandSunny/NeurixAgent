+```ts
+import { WebSocketServer } from "ws";
+import type { StatusEvent } from "./oscBridge.js";
+
+export class WsHub {
+  private wss: WebSocketServer;
+  constructor(server: import("http").Server) {
+    this.wss = new WebSocketServer({ server, path: "/ws/status" });
+  }
+  broadcast(ev: StatusEvent) {
+    const data = JSON.stringify({ type: "status", payload: ev });
+    this.wss.clients.forEach((c) => {
+      if (c.readyState === 1) c.send(data);
+    });
+  }
+  async close(): Promise<void> {
+    await new Promise<void>((resolve, reject) => {
+      this.wss.close((err) => {
+        if (err) {
+          reject(err);
+          return;
+        }
+        resolve();
+      });
+    });
+  }
+}
