+## `server/src/oscBridge.ts`
+```ts
+import OSC from "osc";
+import { EventEmitter } from "node:events";
+
+type OscUdpPort = {
+  open(): void;
+  close(): void;
+  on(event: string, handler: (message: unknown) => void): void;
+  removeAllListeners?(event?: string): void;
+};
+
+export interface StatusEvent {
+  channel: number;
+  layer: number;
+  clipName?: string;
+  timecode?: string;
+  duration?: string;
+  frame?: number;
+  fps?: number;
+  onAir: boolean;
+}
+
+type StatusState = StatusEvent;
+
+type OscArg = unknown | { value: unknown };
+
+type OscMessage = {
+  address?: string;
+  args?: OscArg[];
+};
+
+function parseChannelLayer(address: string | undefined): { channel: number; layer: number } | null {
+  if (!address) return null;
+  const parts = address.split("/").filter(Boolean);
+  if (parts.length < 2) return null;
+  const channel = Number.parseInt(parts[1] ?? "1", 10) || 1;
+  const layerIndex = parts.lastIndexOf("layer");
+  const layer = layerIndex >= 0 ? Number.parseInt(parts[layerIndex + 1] ?? "1", 10) || 1 : 1;
+  return { channel, layer };
+}
+
+function unwrapArg(value: OscArg | undefined): unknown {
+  if (value && typeof value === "object" && "value" in value) {
+    return (value as { value: unknown }).value;
+  }
+  return value;
+}
+
+function asString(value: OscArg | undefined): string | undefined {
+  const raw = unwrapArg(value);
+  if (raw === undefined || raw === null) return undefined;
+  const str = String(raw).trim();
+  return str.length ? str : undefined;
+}
+
+function asNumber(value: OscArg | undefined): number | undefined {
+  const raw = unwrapArg(value);
+  const num = typeof raw === "number" ? raw : Number(raw);
+  return Number.isFinite(num) ? num : undefined;
+}
+
+function ensureState(
+  state: Map<string, StatusState>,
+  channel: number,
+  layer: number,
+): StatusState {
+  const key = `${channel}:${layer}`;
+  let current = state.get(key);
+  if (!current) {
+    current = { channel, layer, onAir: false };
+    state.set(key, current);
+  }
+  return current;
+}
+
+export function applyOscUpdate(
+  state: Map<string, StatusState>,
+  message: OscMessage,
+): StatusEvent | null {
+  const { address, args = [] } = message;
+  const parsed = parseChannelLayer(address);
+  if (!parsed) return null;
+  const { channel, layer } = parsed;
+  const current = ensureState(state, channel, layer);
+
+  let updated = false;
+
+  if (address?.endsWith("/file/name")) {
+    const clipName = asString(args[0]);
+    if (clipName !== undefined && clipName !== current.clipName) {
+      current.clipName = clipName;
+      updated = true;
+    }
+    if (!current.onAir) {
+      current.onAir = true;
+      updated = true;
+    }
+  } else if (address?.endsWith("/file/time")) {
+    const timecode = asString(args[0]);
+    const fps = asNumber(args[1]);
+    if (timecode !== undefined && timecode !== current.timecode) {
+      current.timecode = timecode;
+      updated = true;
+    }
+    if (fps !== undefined && fps !== current.fps) {
+      current.fps = fps;
+      updated = true;
+    }
+    if (!current.onAir) {
+      current.onAir = true;
+      updated = true;
+    }
+  } else if (address?.endsWith("/file/duration")) {
+    const duration = asString(args[0]);
+    if (duration !== undefined && duration !== current.duration) {
+      current.duration = duration;
+      updated = true;
+    }
+    if (!current.onAir) {
+      current.onAir = true;
+      updated = true;
+    }
+  } else if (address?.endsWith("/file/frame")) {
+    const frame = asNumber(args[0]);
+    if (frame !== undefined && frame !== current.frame) {
+      current.frame = frame;
+      updated = true;
+    }
+  } else if (address?.endsWith("/file/fps")) {
+    const fps = asNumber(args[0]);
+    if (fps !== undefined && fps !== current.fps) {
+      current.fps = fps;
+      updated = true;
+    }
+  } else if (address?.endsWith("/foreground")) {
+    const onAir = Boolean(args[0]);
+    if (onAir !== current.onAir) {
+      current.onAir = onAir;
+      updated = true;
+    }
+  }
+
+  if (!updated) return null;
+
+  return { ...current };
+}
+
+export class OscBridge extends EventEmitter {
+  private udpPort: OscUdpPort;
+  private readonly state = new Map<string, StatusState>();
+
+  constructor(listenPort: number) {
+    super();
+    this.udpPort = new (OSC as unknown as {
+      UDPPort: new (options: { localAddress: string; localPort: number }) => OscUdpPort;
+    }).UDPPort({ localAddress: "0.0.0.0", localPort: listenPort });
+    this.udpPort.on("message", (m) => this.onOsc(m as OscMessage));
+  }
+  start() {
+    this.udpPort.open();
+  }
+  stop() {
+    if (this.udpPort) {
+      if (typeof this.udpPort.removeAllListeners === "function") {
+        this.udpPort.removeAllListeners("message");
+      }
+      this.udpPort.close();
+    }
+    this.state.clear();
+  }
+  private onOsc(msg: OscMessage) {
+    const updated = applyOscUpdate(this.state, msg);
+    if (updated) this.emit("status", updated);
+  }
+}
