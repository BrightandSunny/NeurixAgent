+## `server/src/index.ts`
+```ts
+import express from "express";
+import bodyParser from "body-parser";
+import http from "node:http";
+import fs from "node:fs";
+import path from "node:path";
+
+import { cfg } from "./config/env.js";
+import { startOscIngest, stopOscIngest } from "./osc/ingest.js";
+
+import { corsDevOnly } from "./http/mw/corsDevOnly.js";
+import { safeJson } from "./http/mw/safeJson.js";
+import casparRoutes from "./http/routes/caspar.js";
+import metaRoutes from "./http/routes/meta.js";
+import { startStatusWsServer, stopStatusWsServer } from "./ws/statusServer.js";
+import { previewCors, setHlsHeaders } from "./http/mw/previewCors.js";
+import { disposeAmcpClient } from "./amcp/index.js";
+
+/* ─────────────────────────── Helpers ─────────────────────────── */
+
+function pickHlsDir(): { root: string; source: string } {
+  const candidates = [
+    { v: cfg.hlsDir, label: "cfg.hlsDir" },
+    { v: cfg.preview.hlsDir, label: "cfg.preview.hlsDir" },
+    { v: process.env.HLS_DIR, label: "process.env.HLS_DIR" },
+  ];
+
+  for (const candidate of candidates) {
+    const cleaned = String(candidate.v ?? "")
+      .trim()
+      .replace(/^['"]|['"]$/g, "");
+    if (cleaned) {
+      return { root: path.resolve(cleaned), source: candidate.label };
+    }
+  }
+  throw new Error("[HLS] No HLS directory configured. Set cfg.hlsDir, cfg.preview.hlsDir, or HLS_DIR (e.g. D:\\NeurixPlay\\previewer\\public\\preview).");
+}
+
+function ensureDir(targetPath: string) {
+  try {
+    if (!fs.existsSync(targetPath)) {
+      fs.mkdirSync(targetPath, { recursive: true });
+    }
+  } catch (error) {
+    console.warn(`[HLS] Could not create directory: ${targetPath}`, error);
+  }
+}
+
+/* ─────────────────────────── App ─────────────────────────── */
+
+const app = express();
+app.use(bodyParser.json());
+app.use(corsDevOnly);
+app.use(safeJson);
+
+/** Resolve + validate HLS root once on startup */
+const { root: HLS_ROOT, source: HLS_SRC } = pickHlsDir();
+ensureDir(HLS_ROOT);
+
+/** Serve the HLS preview (manifest + segments) */
+app.use(
+  "/preview",
+  previewCors,
+  express.static(HLS_ROOT, {
+    fallthrough: false,
+    setHeaders: (res, filePath) => setHlsHeaders(res, filePath),
+  }),
+);
+
+/** Meta + control routes */
+app.use("/api", metaRoutes);
+app.use("/api/caspar", casparRoutes);
+
+/* ───────────────────── HTTP server + WebSocket ───────────────────── */
+
+const server = http.createServer(app);
+startStatusWsServer(server);
+
+/* ────────────────────────── Boot & logging ───────────────────────── */
+
+function onListening(port: number) {
+  console.log("[CONFIG] using", {
+    httpPort: port,
+    caspar: { host: cfg.caspar.host, amcpPort: cfg.caspar.amcpPort },
+    osc: { listenPort: cfg.osc.listenPort },
+    hlsDir: HLS_ROOT,
+    hlsFrom: HLS_SRC,
+    logLevel: cfg.logLevel,
+  });
+
+  console.log(`[HTTP] listening on :${port}`);
+  console.log(`[HLS]  serving preview dir: "${HLS_ROOT}"`);
+  console.log(`[OSC]  listening on udp://0.0.0.0:${cfg.osc.listenPort}`);
+
+  startOscIngest();
+}
+
+function onError(err: NodeJS.ErrnoException | null, port: number) {
+  if (err?.code === "EADDRINUSE") {
+    const fallback = port + 1;
+    console.warn(`[HTTP] port ${port} in use; trying ${fallback} …`);
+    server.removeAllListeners("error");
+    server.listen(fallback, () => onListening(fallback));
+    server.on("error", (error) => {
+      console.error("[HTTP] failed to bind fallback port", error);
+      process.exit(1);
+    });
+    return;
+  }
+  console.error("[HTTP] fatal listen error:", err);
+  process.exit(1);
+}
+
+/* ─────────────────────────────────────────────────────────────────── */
+
+server.listen(cfg.httpPort, () => onListening(cfg.httpPort));
+server.on("error", (error) => onError(error as NodeJS.ErrnoException, cfg.httpPort));
+
+function handleShutdown(signal: NodeJS.Signals) {
+  console.log(`[SHUTDOWN] received ${signal}, closing services`);
+  stopOscIngest();
+  void stopStatusWsServer().finally(() => {
+    disposeAmcpClient();
+    server.close(() => process.exit(0));
+  });
+}
+
+process.on("SIGINT", handleShutdown);
+process.on("SIGTERM", handleShutdown);
+
+export {};
+```
